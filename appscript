function checkNewEmails() {
  var threads = GmailApp.getInboxThreads(0, 10); // Get up to 10 inbox Threads
  let data = [];
  
  if (threads.length > 0) {
    threads.forEach(thread => {
      var messages = thread.getMessages();
      
      messages.forEach(message => {
        if (!message.isUnread()) return;
        
        var fromEmail = message.getFrom();
        var toEmail = message.getTo();

        var subject = message.getSubject().replace(/^Re:\s*/i, "");
        var body = message.getPlainBody(); 
        
        var fromMatch = fromEmail.match(/<([^>]*)>/);
        var toMatch = toEmail.match(/<([^>]*)>/);
        
        var from = fromMatch ? fromMatch[1] : fromEmail; 
        var to = toMatch ? toMatch[1] : toEmail;
        var date = message.getDate();
        
        // --- NEW: Extract Attachments and Encode to Base64 ---
        var attachments = message.getAttachments();
        var attachmentData = attachments.map(attachment => {
          var blob = attachment.copyBlob(); // Get the raw file data
          var base64String = Utilities.base64Encode(blob.getBytes()); // Convert to Base64
          
          return {
            name: attachment.getName(),
            contentType: attachment.getContentType(),
            size: attachment.getSize(),
            base64: base64String // This is the actual file data to send
          };
        });
        
        const result = {
          subject: subject,
          from: from,
          to: to,
          date: date,
          messageId: message.getId(),
          threadId: thread.getId(), 
          count: messages.length,
          attachments: attachmentData // Includes the base64 encoded files
        };
        
        data.push(result);
      });
    });

    if (data.length > 0) {
      const uniqueEmails = Object.values(
        data.reduce((acc, email) => {
          if (!acc[email.from]) {
            acc[email.from] = email;
          }
          return acc;
        }, {})
      );
      
      console.log('count:', uniqueEmails);

      // --- NEW: Upload to API ---
      // var apiUrl = "https://your-api-endpoint.com/api/webhook"; // Replace with your actual API URL
      
      // var options = {
      //   method: "post",
      //   contentType: "application/json",
      //   payload: JSON.stringify(uniqueEmails),
      //   muteHttpExceptions: true 
      // };
      
      // try {
      //   var res = UrlFetchApp.fetch(apiUrl, options);
      //   Logger.log("API Response Code: " + res.getResponseCode());
      //   Logger.log("API Response Body: " + res.getContentText());
        
      // } catch (e) {
      //   Logger.log("Error sending to API: " + e.message);
      // }

    } else {
      Logger.log("No new email data to send.");
    }
  } else {
    Logger.log("No new emails.");
  }
}


function findTheApplicant(applicant) {
  const regex = /\b(Application:)\w\b/gi; // Matches sequences that start with CF or PS and have 14 total characters
  return applicant.match(regex) || [];
}
